{
  "name": "pedag",
  "version": "0.3.0",
  "description": "A language for programs that reason under uncertainty: probabilistic control flow, first-class tensors, capability security, provenance tracking, and contracts that generate their own tests.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pedag": "bin/pedag.mjs",
    "pedag-verify": "tools/verify-manifest.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "src/",
    "std/",
    "tools/verify-manifest.mjs",
    "examples/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "VERSIONING.md",
    "LIMITATIONS.md"
  ],
  "keywords": [
    "programming-language",
    "interpreter",
    "capability-security",
    "taint-tracking",
    "probabilistic-programming",
    "contracts",
    "property-testing",
    "homomorphic-encryption",
    "zero-knowledge",
    "actors",
    "tensors"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "tour": "node bin/pedag.mjs run examples/tour.pedag",
    "prove": "node bin/pedag.mjs prove examples/contracts.pedag",
    "check": "node bin/pedag.mjs check examples/agents.pedag",
    "examples": "node bin/pedag.mjs run examples/quantum.pedag && node bin/pedag.mjs run examples/agents.pedag && node bin/pedag.mjs run examples/devices.pedag && node bin/pedag.mjs run examples/crypto.pedag --grant crypto,unaudited_crypto",
    "fuzz": "node tools/fuzz.mjs 20000",
    "diff": "node tools/differential.mjs",
    "bench": "node tools/bench.mjs",
    "bench:compare": "node bench/compare.mjs 27 5",
    "ab": "node tools/ab.mjs"
  }
}
